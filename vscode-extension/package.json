{
  "name": "aquadrop",
  "displayName": "AquaDrop — Hydration Reminder",
  "description": "A premium hydration reminder for developers working in VS Code.",
  "version": "0.1.0",
  "publisher": "Shivammavi",
  "icon": "media/aquadrop-icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:aquadrop.openDashboard",
    "onCommand:aquadrop.drinkWater",
    "onCommand:aquadrop.snoozeReminder",
    "onCommand:aquadrop.pauseReminders",
    "onCommand:aquadrop.resumeReminders",
    "onCommand:aquadrop.toggleReminders",
    "onCommand:aquadrop.resetDailyProgress"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aquadrop",
          "title": "AquaDrop",
          "icon": "media/aquadrop-icon.svg"
        }
      ]
    },
    "views": {
      "aquadrop": [
        {
          "type": "webview",
          "id": "aquadrop.sidebar",
          "name": "AquaDrop"
        }
      ]
    },
    "commands": [
      {
        "command": "aquadrop.openDashboard",
        "title": "AquaDrop: Open Dashboard"
      },
      {
        "command": "aquadrop.drinkWater",
        "title": "AquaDrop: Drink Water"
      },
      {
        "command": "aquadrop.snoozeReminder",
        "title": "AquaDrop: Snooze Reminder"
      },
      {
        "command": "aquadrop.pauseReminders",
        "title": "AquaDrop: Pause Reminders"
      },
      {
        "command": "aquadrop.resumeReminders",
        "title": "AquaDrop: Resume Reminders"
      },
      {
        "command": "aquadrop.toggleReminders",
        "title": "AquaDrop: Toggle Reminders"
      },
      {
        "command": "aquadrop.resetDailyProgress",
        "title": "AquaDrop: Reset Daily Progress"
      },
      {
        "command": "aquadrop.startReminders",
        "title": "AquaDrop: Start Reminders"
      },
      {
        "command": "aquadrop.logWater",
        "title": "AquaDrop: Log Water"
      },
      {
        "command": "aquadrop.changeInterval",
        "title": "AquaDrop: Change Reminder Interval"
      },
      {
        "command": "aquadrop.openSettings",
        "title": "AquaDrop: Open Settings"
      }
    ],
    "configuration": {
      "title": "AquaDrop",
      "properties": {
        "aquadrop.remindersEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable AquaDrop reminders."
        },
        "aquadrop.intervalMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 1440,
          "description": "Reminder interval in minutes."
        },
        "aquadrop.snoozeMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 180,
          "description": "How long to snooze a reminder in minutes."
        },
        "aquadrop.notificationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show desktop notifications for AquaDrop reminders."
        },
        "aquadrop.dailyGoal": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 200,
          "description": "Daily water-break goal used for progress tracking."
        },
        "aquadrop.appearance": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ],
          "default": "system",
          "description": "Choose how AquaDrop should appear in VS Code."
        },
        "aquadrop.enabledByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Legacy compatibility flag for reminder default state."
        },
        "aquadrop.trackHydration": {
          "type": "boolean",
          "default": true,
          "description": "Record water-break entries in the extension state."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}
