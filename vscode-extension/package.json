{
  "name": "aquadrop",
  "displayName": "Drink Water - Hydration Reminder",
  "description": "Drink Water reminders & daily hydration tracker for developers working in Visual Studio Code.",
  "version": "1.1.0",
  "publisher": "shivammavi",
  "author": {
    "name": "Shivam Mavi"
  },
  "license": "MIT",
  "homepage": "https://aqua-drop-seven.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shivammraj/AquaDrop.git"
  },
  "bugs": {
    "url": "https://github.com/shivammraj/AquaDrop/issues"
  },
  "icon": "media/aquadrop-icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "keywords": [
    "drink water",
    "water reminder",
    "drink water reminder",
    "hydration",
    "health",
    "water",
    "reminder",
    "wellness",
    "break",
    "timer",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aquadrop",
          "title": "Drink Water",
          "icon": "media/aquadrop-icon.svg"
        }
      ]
    },
    "views": {
      "aquadrop": [
        {
          "type": "webview",
          "id": "aquadrop.sidebar",
          "name": "Drink Water"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aquadrop.drinkWater",
          "when": "view == aquadrop.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "aquadrop.openDashboard",
          "when": "view == aquadrop.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "aquadrop.openSettings",
          "when": "view == aquadrop.sidebar",
          "group": "navigation@3"
        }
      ]
    },
    "commands": [
      {
        "command": "aquadrop.openDashboard",
        "title": "Drink Water: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "aquadrop.drinkWater",
        "title": "Drink Water: Log Water (I've Drunk Water)",
        "icon": "$(heart)"
      },
      {
        "command": "aquadrop.snoozeReminder",
        "title": "Drink Water: Snooze Reminder",
        "icon": "$(watch)"
      },
      {
        "command": "aquadrop.pauseReminders",
        "title": "Drink Water: Pause Reminders",
        "icon": "$(debug-pause)"
      },
      {
        "command": "aquadrop.resumeReminders",
        "title": "Drink Water: Resume Reminders",
        "icon": "$(play)"
      },
      {
        "command": "aquadrop.toggleReminders",
        "title": "Drink Water: Toggle Reminders"
      },
      {
        "command": "aquadrop.resetDailyProgress",
        "title": "Drink Water: Reset Daily Progress",
        "icon": "$(discard)"
      },
      {
        "command": "aquadrop.startReminders",
        "title": "Drink Water: Start Reminders"
      },
      {
        "command": "aquadrop.logWater",
        "title": "Drink Water: Log Water"
      },
      {
        "command": "aquadrop.changeInterval",
        "title": "Drink Water: Change Reminder Interval"
      },
      {
        "command": "aquadrop.testSound",
        "title": "Drink Water: Test Reminder Sound",
        "icon": "$(unmute)"
      },
      {
        "command": "aquadrop.openSettings",
        "title": "Drink Water: Open Settings",
        "icon": "$(gear)"
      }
    ],
    "configuration": {
      "title": "Drink Water",
      "properties": {
        "aquadrop.remindersEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable automatic hydration reminders."
        },
        "aquadrop.intervalMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 1440,
          "description": "Reminder interval in minutes."
        },
        "aquadrop.snoozeMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 180,
          "description": "Duration to snooze reminders in minutes."
        },
        "aquadrop.notificationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show native desktop notifications when water break reminders trigger."
        },
        "aquadrop.soundEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Play a gentle synthesized water chime and drinking sounds when a hydration reminder is due in open AquaDrop views."
        },
        "aquadrop.voiceType": {
          "type": "string",
          "enum": [
            "female",
            "male",
            "chime-only"
          ],
          "enumDescriptions": [
            "Friendly & warm girl voice reminder with real drinking sounds",
            "Encouraging & clear boy voice reminder with real drinking sounds",
            "Real drinking sounds and water drop chime only (no voice)"
          ],
          "default": "female",
          "description": "Choose hydration alert voice persona and sound."
        },
        "aquadrop.dailyGoal": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 200,
          "description": "Target number of daily water breaks for progress tracking."
        },
        "aquadrop.appearance": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow active VS Code editor theme",
            "Light blue clean aesthetic",
            "Deep dark blue palette"
          ],
          "default": "system",
          "description": "Visual theme appearance for AquaDrop sidebar and dashboard."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}
